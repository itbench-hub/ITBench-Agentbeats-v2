# ==============================================================================
# ITBench Agentbeats - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
#
# Usage:
#   cp .env.tmpl .env
#   # Edit .env with your API keys

# ==============================================================================
# Agent Configuration
# ==============================================================================
# LLM configuration for the agent
AGENT_URL="https://openrouter.ai/api/v1"
AGENT_API_KEY="<API-KEY>"
AGENT_PROVIDER="openrouter"
AGENT_MODEL="google/gemini-3-pro-preview"

# ==============================================================================
# Evaluator Configuration
# ==============================================================================
# LLM configuration for the evaluator (LLM-as-a-Judge)
EVALUATOR_URL="https://openrouter.ai/api/v1"
EVALUATOR_API_KEY="<API-KEY>"
EVALUATOR_PROVIDER="openrouter"
EVALUATOR_MODEL="google/gemini-3-pro-preview"
